erDiagram
    users {
        BINARY id PK
        VARCHAR email UK
        VARCHAR display_name
        ENUM role
        INT reputation_score
    }
    categories {
        BINARY id PK
        VARCHAR name UK
        VARCHAR slug UK
        DECIMAL severity_weight
    }
    website_urls {
        BINARY id PK
        TEXT normalized_url UK
        VARCHAR domain
        DECIMAL risk_score
    }
    fraud_reports {
        BINARY id PK
        BINARY reporter_id FK
        BINARY website_url_id FK
        BINARY category_id FK
        VARCHAR title
        ENUM status
        ENUM verification_stage
    }
    report_evidence {
        BINARY id PK
        BINARY report_id FK
        BINARY uploaded_by FK
        ENUM evidence_type
    }
    verification_votes {
        BINARY id PK
        BINARY report_id FK
        BINARY voter_id FK
        ENUM vote_type
    }
    tags {
        BINARY id PK
        VARCHAR name UK
        VARCHAR slug UK
    }
    report_tags {
        BINARY report_id FK
        BINARY tag_id FK
    }
    report_comments {
        BINARY id PK
        BINARY report_id FK
        BINARY user_id FK
        BINARY parent_id FK
    }
    report_history {
        BINARY id PK
        BINARY report_id FK
        BINARY actor_id FK
        ENUM action
    }
    risk_score_breakdowns {
        BINARY id PK
        BINARY website_url_id FK
        DECIMAL community_sub_score
        DECIMAL automated_sub_score
        DECIMAL final_score
    }
    appeals {
        BINARY id PK
        BINARY report_id FK
        VARCHAR appellant_email
        ENUM status
        BINARY resolved_by FK
    }
    appeal_evidence {
        BINARY id PK
        BINARY appeal_id FK
        ENUM evidence_type
    }
    reputation_events {
        BINARY id PK
        BINARY user_id FK
        INT delta
        ENUM reason
    }
    rate_limit_events {
        BINARY id PK
        BINARY user_id FK
        VARCHAR action_type
    }
    audit_events {
        BINARY id PK
        BINARY actor_id FK
        VARCHAR action
        VARCHAR entity_type
    }
    platform_config {
        VARCHAR key PK
        JSON value
    }
    website_discussions {
        BINARY id PK
        BINARY website_url_id FK
        BINARY author_id FK
        VARCHAR title
    }
    discussion_replies {
        BINARY id PK
        BINARY discussion_id FK
        BINARY author_id FK
        BINARY parent_id FK
    }
    discussion_votes {
        BINARY id PK
        BINARY user_id FK
        ENUM target_type
        BINARY target_id FK
    }

